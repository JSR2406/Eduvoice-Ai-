# ── EduVoice AI Environment Configuration ─────────────────────────────────────
# Copy this file to .env and fill in your values.

# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Sarvam AI (PRIMARY — Required for production) ──────────────────────────────
# Sign up & get your key: https://dashboard.sarvam.ai/key-management
SARVAM_API_KEY=your_sarvam_api_key_here

# Sarvam model defaults (optional — defaults are already set in settings.py)
# SARVAM_CHAT_MODEL=sarvam-30b
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TRANSLATION_MODEL=mayura:v1

# ── Legacy AI (optional — used as fallback during migration period) ────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ── Deployment config ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
